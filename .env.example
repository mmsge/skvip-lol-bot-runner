# Copy to `.env` on the server (never commit .env).
#
# Every setting resolves prefix-first: a bot reads VESTLENDINGEN_<NAME> if set,
# otherwise the unprefixed <NAME>. So the unprefixed names below are house
# defaults shared by every robot, and a second robot overrides only what it
# disagrees with (ADR 0007).

# ── The one secret ──────────────────────────────────────────────────────────
# Mastodon token for @botlendingen@skvip.lol. Scope: write:statuses ONLY.
# No write:media — the article photo arrives via Mastodon's link preview card,
# and uploading it as well would show the same picture twice.
# Prefix-only on purpose: a shared token would post one robot's articles from
# another robot's account.
VESTLENDINGEN_MASTODON_TOKEN=

# ── House settings ──────────────────────────────────────────────────────────
MASTODON_BASE_URL=https://skvip.lol
PUBLIC_BASE_URL=https://mastobots.skvip.lol
DATA_DIR=/app/data

POLL_INTERVAL_MINUTES=15
MAX_POSTS_PER_CYCLE=5          # a bulk publish cannot flood the timeline
POST_SPACING_SECONDS=20
MAX_ARTICLE_AGE_HOURS=72       # an edited old article does not resurface

# 1 = compose and log, never post. Safe to leave on while you read the output.
DRY_RUN=0
# 1 = post the current corpus on first run instead of marking it seen.
# Leave at 0: the account should start quiet.
BACKFILL=0

# ── Host group for the linjeskift data directory ────────────────────────────
# Read by docker-compose.yml, not by the app. The GID of the host group that
# owns /var/lib/linjeskift (see the README's deploy notes).
LINJESKIFT_GID=10001

# ── linjeskift ──────────────────────────────────────────────────────────────
# Mastodon token for @linjeskift@skvip.lol. Scope: write:statuses ONLY.
# Required unless DRY_RUN=1: without it the house refuses to boot.
LINJESKIFT_MASTODON_TOKEN=
# linjeskift's SQLite database as seen inside the container (the compose file
# mounts /var/lib/linjeskift at /linjeskift). Opened read-only every cycle.
LINJESKIFT_DB_PATH=/linjeskift/linjeskift.db
# Digest items below this relevance (0 to 1) are not posted. Breaking items
# ignore it.
LINJESKIFT_RELEVANCE_MIN=0.30
LINJESKIFT_LANGUAGE=en          # the toots are the original English headlines
# Used VERBATIM. The category and country hashtags are added after it.
LINJESKIFT_BASE_HASHTAGS=Linjeskift
# 1 = on first run, post what is inside MAX_ARTICLE_AGE_HOURS (capped per cycle)
# instead of marking it seen. On by default for this robot, so the account
# starts with recent news; set 0 to start quiet.
LINJESKIFT_BACKFILL=1

# ── vestlendingen ───────────────────────────────────────────────────────────
VESTLENDINGEN_LANGUAGE=no       # the paper publishes in both Bokmål and Nynorsk
VESTLENDINGEN_VISIBILITY=public
# Used VERBATIM, not CamelCased — which is what keeps #nyhende lower case.
VESTLENDINGEN_BASE_HASHTAGS=Vestlandet nyhende

# skip | unlisted | post — see docs/decision-records/0004-*.md.
# Five of fourteen articles carry robots.noindex and nobody outside the paper
# can say what it means. `skip` until the editors answer; flip it here the hour
# they do, and raise MAX_ARTICLE_AGE_HOURS for one cycle to bring the held
# articles back.
VESTLENDINGEN_NOINDEX_POLICY=skip

# The daily briefs ("Torsdag 20. august"). Matched on the heading, never the
# category — `aktuelt` also holds real reporting. Both written traditions.
VESTLENDINGEN_SKIP_HEADING_PATTERN=^(m[åa]ndag|tysdag|tirsdag|onsdag|torsdag|fredag|laurdag|l[øo]rdag|sundag|s[øo]ndag)\s+\d{1,2}\.\s+(januar|februar|mars|april|mai|juni|juli|august|september|oktober|november|desember)$

# ── vestlendingen's source ──────────────────────────────────────────────────
SANITY_PROJECT_ID=6bxsir9v
SANITY_DATASET=production
SOURCE_ORIGIN=https://www.vestlendingen.no
SOURCE_SITEMAP=https://www.vestlendingen.no/articles/sitemap/0.xml
